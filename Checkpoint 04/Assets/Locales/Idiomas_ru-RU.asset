  - m_Id: 8910990897152
    m_Localized: "\xA9 2026 HappySoftware. \u0412\u0441\u0435 \u043F\u0440\u0430\u0432\u0430
      \u0437\u0430\u0449\u0438\u0449\u0435\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10909824217088
    m_Localized: "\u041E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 11915249217536
    m_Localized: "\u041E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435 v1.0.2"
    m_Metadata:
      m_Items: []
  - m_Id: 12575076151296
    m_Localized: "\u0412\u0441\u0435\u043C \u043F\u0440\u0438\u0432\u0435\u0442!
      \u041D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435
      \u0443\u0436\u0435 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 13185380937728
    m_Localized: "\u0418\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F\n\n-\u0423\u043B\u0443\u0447\u0448\u0435\u043D\u043E
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u043A\u0430\u043C\u0435\u0440\u044B.\n-\u0418\u0441\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u044B
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B
      \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430.\n-\u0423\u043B\u0443\u0447\u0448\u0435\u043D\u0430
      \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u0438\u0433\u0440\u044B.\n-\u0418\u0441\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u044B
      \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043E\u0448\u0438\u0431\u043A\u0438
      \u0442\u0435\u043A\u0441\u0442\u0430 \u0438 \u043B\u043E\u043A\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438.\n-\u0414\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u044B
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u044B\u0435
      \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F.\n\n\u0421\u043F\u0430\u0441\u0438\u0431\u043E
      \u0437\u0430 \u0438\u0433\u0440\u0443 \u0438 \u0437\u0430 \u0432\u0430\u0448\u0438
      \u043E\u0442\u0437\u044B\u0432\u044B!\n\n\u2014 \u041A\u043E\u043C\u0430\u043D\u0434\u0430
      HappySoftware"
    m_Metadata:
      m_Items: []
